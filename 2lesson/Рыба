#include <iostream>
#include <sqlite3.h>

using namespace std;

// Функция для обработки ошибок SQLite
bool checkError(int rc, char* errMsg, const char* action) {
    if (rc != SQLITE_OK) {
        cerr << "Ошибка " << action << ": " << errMsg << endl;
        sqlite3_free(errMsg);
        return false;
    }
    return true;
}

int main() {
    sqlite3* db;
    char* errMsg = 0;
    
    // 1. Открытие или создание базы данных (файл users.db появится в папке проекта)
    int rc = sqlite3_open("users.db", &db);
    if (rc) {
        cerr << "Не удалось открыть базу данных: " << sqlite3_errmsg(db) << endl;
        return (0);
    } else {
        cout << "База данных успешно открыта/создана!" << endl;
    }

    // 2. Создание таблицы Users, если она еще не существует
    string sqlCreate = "CREATE TABLE IF NOT EXISTS Users("
                       "ID INTEGER PRIMARY KEY AUTOINCREMENT, "
                       "NAME TEXT NOT NULL, "
                       "AGE INT NOT NULL);";

    rc = sqlite3_exec(db, sqlCreate.c_str(), 0, 0, &errMsg);
    if (!checkError(rc, errMsg, "создания таблицы")) {
        sqlite3_close(db);
        return 1;
    }

    // 3. Добавление тестовой записи (INSERT)
    string sqlInsert = "INSERT INTO Users (NAME, AGE) VALUES ('Алексей', 20);";
    rc = sqlite3_exec(db, sqlInsert.c_str(), 0, 0, &errMsg);
    if (!checkError(rc, errMsg, "добавления записи")) {
        sqlite3_close(db);
        return 1;
    }
    cout << "Пользователь успешно добавлен в базу." << endl;

    // 4. Чтение данных из базы (SELECT)
    cout << "\nСписок пользователей в базе:" << endl;
    string sqlSelect = "SELECT ID, NAME, AGE FROM Users;";
    
    // Callback-функция для обработки результатов запроса SELECT
    auto callback = [](void* data, int argc, char** argv, char** azColName) -> int {
        for (int i = 0; i < argc; i++) {
            cout << azColName[i] << ": " << (argv[i] ? argv[i] : "NULL") << " | ";
        }
        cout << endl;
        return 0;
    };

    rc = sqlite3_exec(db, sqlSelect.c_str(), callback, 0, &errMsg);
    if (!checkError(rc, errMsg, "выборки данных")) {
        sqlite3_close(db);
        return 1;
    }

    // 5. Закрытие базы данных
    sqlite3_close(db);
    return 0;
}

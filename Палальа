#include <iostream>
#include <vector>

int main() {
    // Установка русской локали для корректного вывода (если потребуется)
    std::setlocale(LC_ALL, "Russian");

    // Задаем двумерный массив (вектор векторов) с цифрами от 5 до 9
    std::vector<std::vector<int>> number_art = {
        {5, 5, 7, 7, 5, 5, 7, 7, 5, 5},
        {5, 7, 9, 9, 7, 7, 9, 9, 7, 5},
        {7, 9, 9, 9, 9, 9, 9, 9, 9, 7},
        {7, 9, 9, 9, 9, 9, 9, 9, 9, 7},
        {5, 7, 9, 9, 9, 9, 9, 9, 7, 5},
        {5, 5, 7, 9, 9, 9, 9, 7, 5, 5},
        {5, 5, 5, 7, 9, 9, 7, 5, 5, 5},
        {5, 5, 5, 5, 7, 7, 5, 5, 5, 5}
    };

    std::cout << "Ваш рисунок из цифр (от 5 до 9):\n\n";

    // Проходим по каждой строке массива
    for (size_t i = 0; i < number_art.size(); ++i) {
        // Проходим пождому элементу (цифре) в строке
        for (size_t j = 0; j < number_art[i].size(); ++j) {
            std::cout << number_art[i][j] << " ";
        }
        // Перевод строки после каждого ряда
        std::cout << std::endl;
    }

    return 0;
}
